# =================================================================
# NEXUS ULTRA PROMAX — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.production on production host and populate secrets.
# NEVER commit .env.production to version control.
# =================================================================

# Database Credentials (PostgreSQL / TimescaleDB)
POSTGRES_USER=nexus_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_HIGH_ENTROPY_ALPHANUMERIC_SECRET_32CHARS
POSTGRES_DB=nexus_prod

# Application Authentication Secrets
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_64_CHARACTER_CRYPTOGRAPHIC_RANDOM_SECRET

# Client Ingress & Allowed CORS Origins (comma-separated, HTTPS mandatory)
# Example: https://nexus.yourdomain.com
ALLOWED_ORIGIN=https://nexus.yourdomain.com

# Public Service Endpoints (used by clients & reverse proxies)
VITE_SIGNAL_URL=https://nexus.yourdomain.com
VITE_ANALYSIS_URL=wss://nexus.yourdomain.com

# LiveKit Real-Time Media SFU
# Generate with: livekit-server generate-keys
LIVEKIT_API_KEY=CHANGE_ME_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=CHANGE_ME_LIVEKIT_API_SECRET_AT_LEAST_32CHARS
LIVEKIT_WS_URL=wss://nexus.yourdomain.com/livekit
VITE_LIVEKIT_WS_URL=wss://nexus.yourdomain.com/livekit

# Google Gemini API (Server-Side Only)
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Logging & Operational Config
LOG_LEVEL=INFO
