# =================================================================
# NEXUS — LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust variables as needed.
# NEVER commit your real .env file containing secrets to version control.
# =================================================================

# -----------------------------------------------------------------
# 1. Database Connections (PostgreSQL & TimescaleDB)
# -----------------------------------------------------------------
# Primary Prisma database connection string for Signaling Server
APP_DATABASE_URL=postgresql://postgres:password@localhost:5432/nexus

# Time-series telemetry database connection string for Analysis API
TELEMETRY_DATABASE_URL=postgresql://postgres:password@localhost:5432/nexus

# -----------------------------------------------------------------
# 2. Redis Event Cache & Pub/Sub
# -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------
# 3. Authentication & JWT Secrets
# -----------------------------------------------------------------
# Secure 64+ character random string for signing JWT session tokens
JWT_SECRET=nexus_ultra_promax_jwt_super_secret_signing_key_at_least_64_characters_long_for_security

# Internal secret for service-to-service communication between signaling-server and analysis-api
INTERNAL_API_TOKEN=internal_api_token_secret_for_service_to_service_calls

# Optional: Disable rate limiting in local automated test runs (true/false)
DISABLE_RATE_LIMIT=false

# -----------------------------------------------------------------
# 4. Service Ports & Ingress
# -----------------------------------------------------------------
PORT=4000
ALLOWED_ORIGIN=http://localhost:3000,http://localhost:5173

# Frontend client service discovery endpoints
VITE_SIGNAL_URL=http://localhost:4000
VITE_ANALYSIS_URL=http://localhost:8000

# -----------------------------------------------------------------
# 5. LiveKit SFU (WebRTC Media Server)
# -----------------------------------------------------------------
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=http://localhost:7880
LIVEKIT_WS_URL=ws://localhost:7880
VITE_LIVEKIT_WS_URL=ws://localhost:7880

# -----------------------------------------------------------------
# 6. Google Gemini API (Server-Side Debriefs & Summaries)
# -----------------------------------------------------------------
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# -----------------------------------------------------------------
# 7. Initial Admin Seed Credentials (Optional)
# -----------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Password123!
ADMIN_USERNAME=admin
ADMIN_NAME=Admin User
