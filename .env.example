# ========================================
# NEXUS — Environment Variables Example
# ========================================
# Copy this file to .env and fill in values

# JWT Authentication (min 64-char random string)
# Get this: Generate a random string using a password generator
# Required: Yes
JWT_SECRET=your_64_character_minimum_random_secret_string_change_this_in_production_immediately

# MongoDB
# Get this: MongoDB Atlas connection string
# Required: Yes
MONGO_URI=mongodb://your_db_username:your_db_password@your_host/nexus

# TimescaleDB / Neon Database
# Get this: Neon DB connection string
# Required: Optional
TIMESCALE_URL=postgresql://your_db_username:your_db_password@your_host/nexus

# Redis
# Get this: Redis connection string
# Required: Optional
REDIS_URL=redis://your_redis_host:6379
CELERY_BROKER=redis://your_redis_host:6379/0
SIGNAL_REDIS_DB=2

# AI/ML Configuration
WHISPER_MODEL=tiny
TOXICITY_THRESHOLD=0.85

# CORS (comma-separated origins for production)
ALLOWED_ORIGIN=http://localhost:3000,http://localhost:5173

# Server configuration
PORT=4000

# LiveKit Keys
# Get this: LiveKit Cloud Dashboard -> Settings -> Keys
# Required: Yes
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here
LIVEKIT_WS_URL=wss://your_project.livekit.cloud
VITE_LIVEKIT_WS_URL=wss://your_project.livekit.cloud

# Gemini API
# Get this: Google AI Studio -> Get API Key
# Required: Yes (for AI meeting summaries)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary
# Get this: Cloudinary Dashboard
# Required: Optional (for media storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Resend
# Get this: Resend Dashboard -> API Keys
# Required: Optional (for email delivery)
RESEND_API_KEY=your_resend_api_key_here

# Admin Seed (for seedAdmin script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YourStrongPassword123!
ADMIN_USERNAME=admin
ADMIN_NAME=Admin User
